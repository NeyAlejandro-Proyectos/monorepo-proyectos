{
  "name": "monorepo-proyectos",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Monorepo managed with Turborepo, NPM Workspaces, and Maven Multi-Module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:rickandmorty": "turbo run test --filter=rickandmorty-bff",
    "test:taller": "turbo run test --filter=taller-backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "turbo": "^2.4.4"
  }
}

